# ─── Supabase ────────────────────────────────────────────────────────────────
# Sin RLS y sin Supabase Auth: todo pasa por la service role key desde el
# servidor. Nunca la expongas con prefijo NEXT_PUBLIC_ ni la mandes al navegador.
SUPABASE_URL=https://tuproyecto.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Cadena de conexión directa de Postgres. Solo la usa `npm run db:push`.
# Supabase → Project Settings → Database → Connection string → URI
SUPABASE_DB_URL=

# ─── Generación ──────────────────────────────────────────────────────────────
# Escribe los guiones. console.anthropic.com
ANTHROPIC_API_KEY=

# Sintetiza las voces. elevenlabs.io → Profile → API Key
ELEVENLABS_API_KEY=
ELEVENLABS_MODEL_ID=eleven_multilingual_v2

# ─── Pagos (opcional hasta que quieras cobrar) ───────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO=

# ─── Sitio ───────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ─── Binarios (solo si no están en el PATH) ──────────────────────────────────
# FFMPEG_PATH=/opt/homebrew/bin/ffmpeg
# FFPROBE_PATH=/opt/homebrew/bin/ffprobe
