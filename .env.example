# ─── Supabase ────────────────────────────────────────────────────────────────
# Sin RLS y sin Supabase Auth: todo pasa por la service role key desde el
# servidor. Nunca la expongas con prefijo NEXT_PUBLIC_ ni la mandes al navegador.
SUPABASE_URL=https://tuproyecto.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Cadena de conexión directa de Postgres. Solo la usa `npm run db:push`.
# Supabase → Project Settings → Database → Connection string → URI
SUPABASE_DB_URL=

# ─── Generación ──────────────────────────────────────────────────────────────
# Escribe los guiones. console.anthropic.com
ANTHROPIC_API_KEY=

# Sintetiza las voces. elevenlabs.io → Profile → API Key
ELEVENLABS_API_KEY=
ELEVENLABS_MODEL_ID=eleven_multilingual_v2

# ─── Canal de YouTube (opcional: sin esto los videos se suben a mano) ────────
# App OAuth de Google Cloud con la YouTube Data API v3 habilitada. El refresh
# token se saca una sola vez, con el scope youtube.upload, desde la cuenta que
# es dueña del canal; es el único que caduca por desuso.
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=

# ─── Pagos (opcional hasta que quieras cobrar) ───────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO=

# ─── Sitio ───────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ─── ffmpeg (opcional) ───────────────────────────────────────────────────────
# Se usa el del sistema si hay uno en el PATH y, si no, el de `ffmpeg-static`
# que instala npm (es el que usa producción). ffprobe ya no hace falta.
# FFMPEG_PATH=/opt/homebrew/bin/ffmpeg

# ─── Avisos de fallas (recomendado en producción) ────────────────────────────
# Cada generación que falla, cada una que se queda colgada y cada deploy que no
# puede generar mandan un aviso. Sin canal, queda solo en el log de Netlify.
#
# Webhook entrante de Slack, Discord o Google Chat (varios separados por coma).
ALERT_WEBHOOK_URL=
# O por correo, vía Resend (resend.com). El remitente tiene que ser de un
# dominio verificado; sin ALERT_EMAIL_FROM sale de onboarding@resend.dev, que
# Resend solo entrega a la dirección dueña de la cuenta.
RESEND_API_KEY=
ALERT_EMAIL_TO=
ALERT_EMAIL_FROM=

# ─── Dónde corre la generación (normalmente no se toca) ──────────────────────
# `background`: la función de Netlify en segundo plano (lo que se fija solo al
# compilar en Netlify). `inline`: en el mismo proceso (lo de siempre en local).
# GENERATION_RUNNER=
# El encargo a la función se firma con la service role key; esto la reemplaza.
# GENERATION_SECRET=

# ─── Semana automática (npm run semanal) ─────────────────────────────────────
# Voz fija para la sesión larga de la semana. Vacío = rota entre las voces que
# tienen grabada la respiración para ese hueco. Fijarla reutiliza plantillas y
# sale más barato; rotarla varía el canal.
OMTANA_WEEKLY_VOICE=

# ─── Redes sociales por Zernio (npm run zernio) ──────────────────────────────
# zernio.com → API keys. Dos cuentas conectadas son gratis; desde la tercera,
# USD 6 al mes cada una. Sin esto los videos se generan igual y se suben a mano.
ZERNIO_API_KEY=
# Plataformas por defecto y zona horaria de los horarios programados.
PUBLISH_PLATFORMS=youtube,instagram
PUBLISH_TIMEZONE=America/Santiago
# A qué cuentas del workspace de Zernio se publica, por usuario o id, separadas
# por coma. Obligatorio cuando hay más de una cuenta conectada en una misma red:
# sin esto el video saldría en todas, incluidas las de otros proyectos.
PUBLISH_ACCOUNTS=
